# Mode debug : 1 pour dev, 0 pour prod
DEBUG=1

# À remplacer par une vraie clé secrète
SECRET_KEY=your-secret-key-here

# Hôtes autorisés
ALLOWED_HOSTS=localhost,127.0.0.1

# Config PostgreSQL (prod uniquement)
DB_ENGINE=postgres
POSTGRES_DB=your-db-name
POSTGRES_USER=your-db-user
POSTGRES_PASSWORD=your-db-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
